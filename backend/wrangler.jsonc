{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alcoholquit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"1001","simple":{"limit":60,"period":60}}],
  "vars": { "APPLE_CLIENT_ID": "com.alcoholquit.app" },
  "d1_databases": [{ "binding": "DB", "database_name": "alcoholquit", "database_id": "replace-with-your-d1-database-id", "migrations_dir": "migrations" }]
}
